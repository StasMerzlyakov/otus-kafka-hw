{
  "name": "event-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "pgpass",
    "database.dbname": "connect",
    "database.server.name": "postgres",
    "table.include.list": "public.db_event_record",
    "column.exclude.list": "id",
    "topic.prefix": "postgres",
    "transforms": "unwrap,changeTopicName,createKey,extractProcessId,insertTypeIdHeader,replaceField,insertEventType",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.drop.fields.header.name": "id",
    "transforms.unwrap.drop.fields.from.key": "true",
    "transforms.unwrap.drop.fields.keep.schema.compatible": "false",
    "transforms.changeTopicName.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.changeTopicName.regex": "(.*)",
    "transforms.changeTopicName.replacement": "events_topic",
    "transforms.createKey.type":"org.apache.kafka.connect.transforms.ValueToKey",
    "transforms.createKey.fields":"process_id",
    "transforms.extractProcessId.type":"org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractProcessId.field":"process_id",
    "transforms.insertTypeIdHeader.type": "org.apache.kafka.connect.transforms.InsertHeader",
    "transforms.insertTypeIdHeader.header": "__TypeId__",
    "transforms.insertTypeIdHeader.value.literal": "ru.otus.kafka.diplom.testapp.domain.DbEvent",
    "transforms.replaceField.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.replaceField.exclude": "id,__deleted",
    "transforms.insertEventType.type":"org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.insertEventType.static.field":"event_type",
    "transforms.insertEventType.static.value":"Event2000",
    "plugin.name": "pgoutput",
    "tasks.max": "1"
  }
}
