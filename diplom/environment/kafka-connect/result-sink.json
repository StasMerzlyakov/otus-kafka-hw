{
  "name": "result-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "connection.url": "jdbc:postgresql://postgres:5432/connect",
    "connection.user": "postgres",
    "connection.password": "pgpass",
    "topics": "speed_topic",
    "pk.mode": "record_value",
    "pk.fields": "endpoint",
    "auto.create": "false",
    "auto.evolve": "false",
    "insert.mode": "upsert",
    "delete.enabled": "false",
    "fields.whitelist": "endpoint,tps,avg",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "transforms": "route,flatten,unwrap,createKey,extractEndpoint",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "(.*)",
    "transforms.route.replacement": "speed_result",
    "transforms.createKey.type": "org.apache.kafka.connect.transforms.ValueToKey",
    "transforms.createKey.fields": "endpoint",
    "transforms.extractEndpoint.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractEndpoint.field": "endpoint",
    "transforms.flatten.type": "org.apache.kafka.connect.transforms.Flatten$Value",
    "transforms.flatten.delimiter": ".",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState"
  }
}
